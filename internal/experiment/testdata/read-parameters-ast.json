{
  "~effect/Schema": "~effect/Schema",
  "_tag": "Objects",
  "propertySignatures": [
    {
      "name": "filePath",
      "type": {
        "~effect/Schema": "~effect/Schema",
        "annotations": {
          "description": "The absolute path to the file or directory to read"
        },
        "_tag": "String"
      }
    },
    {
      "name": "offset",
      "type": {
        "~effect/Schema": "~effect/Schema",
        "annotations": {
          "description": "The line number to start reading from (1-indexed)"
        },
        "context": { "isOptional": true, "isMutable": false },
        "_tag": "Union",
        "types": [
          {
            "~effect/Schema": "~effect/Schema",
            "checks": [
              {
                "_tag": "Filter",
                "annotations": {
                  "expected": "an integer",
                  "meta": { "_tag": "isInt" },
                  "arbitrary": { "constraint": { "integer": true } }
                },
                "aborted": false
              },
              {
                "_tag": "Filter",
                "annotations": {
                  "expected": "a value greater than or equal to 0",
                  "arbitrary": {
                    "constraint": { "ordered": { "minimum": 0 } }
                  },
                  "meta": { "_tag": "isGreaterThanOrEqualTo", "minimum": 0 }
                },
                "aborted": false
              }
            ],
            "_tag": "Number"
          },
          { "~effect/Schema": "~effect/Schema", "_tag": "Undefined" }
        ],
        "mode": "anyOf"
      }
    },
    {
      "name": "limit",
      "type": {
        "~effect/Schema": "~effect/Schema",
        "annotations": {
          "description": "The maximum number of lines to read (defaults to 2000)"
        },
        "context": { "isOptional": true, "isMutable": false },
        "_tag": "Union",
        "types": [
          {
            "~effect/Schema": "~effect/Schema",
            "checks": [
              {
                "_tag": "Filter",
                "annotations": {
                  "expected": "an integer",
                  "meta": { "_tag": "isInt" },
                  "arbitrary": { "constraint": { "integer": true } }
                },
                "aborted": false
              },
              {
                "_tag": "Filter",
                "annotations": {
                  "expected": "a value greater than or equal to 0",
                  "arbitrary": {
                    "constraint": { "ordered": { "minimum": 0 } }
                  },
                  "meta": { "_tag": "isGreaterThanOrEqualTo", "minimum": 0 }
                },
                "aborted": false
              }
            ],
            "_tag": "Number"
          },
          { "~effect/Schema": "~effect/Schema", "_tag": "Undefined" }
        ],
        "mode": "anyOf"
      }
    }
  ],
  "indexSignatures": []
}
