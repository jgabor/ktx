{
  "contract_version": "cache-reuse-v2",
  "status": "prompt_cache_token_hit_rate_future_successor",
  "activation": {
    "manifest_methodology_version": "v6-prompt-cache-hit-rate",
    "manifest_methodology_cache_metric_contract": "cache-reuse-v2",
    "legacy_manifest_without_marker": "preserve_existing_schema_and_contract"
  },
  "metric": {
    "name": "prompt_cache_token_hit_rate",
    "kind": "token_weighted",
    "unit": "token_fraction",
    "formula": "cache_read / (uncached_input + cache_read + cache_write)",
    "source": "retained_runtime_model_step_telemetry",
    "accounting": "uncached_input_cache_read_and_cache_write_are_disjoint",
    "availability": "all_three_nonnegative_buckets_measured_and_logical_input_positive",
    "measured_zero": "zero_cache_read_with_positive_logical_input_is_measured_zero"
  },
  "comparison": {
    "name": "prompt_cache_token_hit_rate_comparison",
    "phase": "measured_warm",
    "pairing_unit": "cycle",
    "identity": "each_complete_pair_requires_one_matching_runtime_provider_model_and_pinned_runtime_version",
    "identity_pooling": "forbidden",
    "protocol_identity": "manifest_and_attempt_cache_control_and_pipeline_provenance_must_match",
    "minimum_complete_pairs": 5,
    "difference": "candidate_minus_baseline",
    "difference_unit": "percentage_points",
    "aggregation": "for each side over the exact accepted complete pairs, calculate sum(cache_read) / sum(uncached_input + cache_read + cache_write); never average attempt or pair fractions",
    "interval": "two_sided_95_percent_paired_cluster_bootstrap_percentile",
    "resampling": {
      "unit": "complete_pair_disjoint_token_buckets",
      "replicates": 10000,
      "seed": 1,
      "statistic": "candidate aggregate rate minus baseline aggregate rate after each whole-pair resample"
    },
    "quality": "same_complete_pairs_candidate_mean_fact_score_and_full_pass_rate_not_lower",
    "machine_fields": [
      "baseline_mean",
      "candidate_mean",
      "percentage_point_delta",
      "complete_pair_count",
      "interval",
      "quality",
      "blocking_reasons",
      "unavailable_reasons",
      "aggregate_buckets",
      "pairs"
    ]
  },
  "statement_authorization": {
    "name": "prompt_cache_token_hit_rate_statement_authorization",
    "outcomes": ["higher", "lower"],
    "requires": [
      "activated_contract",
      "raw_projection_matches",
      "no_blocking_reasons",
      "at_least_five_complete_pairs",
      "quality_preserved",
      "directional_two_sided_95_percent_interval"
    ],
    "forbidden_claims": [
      "provider_internal_cache_state",
      "request_hit_rate",
      "ttl",
      "eviction",
      "eligibility",
      "isolation",
      "prefix",
      "provider_request_boundaries"
    ]
  },
  "pipeline_acceptance": {
    "name": "pipeline_acceptance",
    "phase": "measured_warm",
    "pairing_unit": "cycle",
    "minimum_complete_pairs": 5,
    "identity_pooling": "forbidden",
    "cost": {
      "kind": "api_equivalent_estimated_cost",
      "formula": "(uncached_input*input_price + cache_read*cache_read_price + cache_write*cache_write_price + output*output_price + reasoning*reasoning_price)/1000000",
      "source": "retained_pricing_snapshot",
      "reported_cost": "not_an_input_and_never_replaced",
      "per_side": "sum rounded per-attempt micro-USD over the exact complete pairs; divide by full_pass=true count"
    },
    "rounding": {
      "currency": "usd",
      "scale_decimals": 6,
      "mode": "half_away_from_zero",
      "per_attempt": "round each API-equivalent estimate to micro-USD before aggregation",
      "per_correct": "sum exact micro-USD, divide by full-pass count, then round to micro-USD"
    },
    "quality": "same_complete_pairs_candidate_mean_fact_score_not_lower_and_full_pass_rate_not_lower",
    "acceptance": "candidate_rounded_api_equivalent_estimated_cost_per_correct_strictly_lower_than_baseline",
    "machine_fields": [
      "accepted",
      "reasons",
      "pair_checks",
      "baseline.estimated_total",
      "baseline.correct_count",
      "baseline.estimated_cost_per_correct",
      "candidate.estimated_total",
      "candidate.correct_count",
      "candidate.estimated_cost_per_correct",
      "quality",
      "rounding",
      "pricing_provenance"
    ],
    "estimate_unavailability_reasons": [
      "uncached_input_unavailable",
      "output_unavailable",
      "reasoning_unavailable",
      "cache_read_unavailable",
      "cache_write_unavailable",
      "uncached_input_nonfinite",
      "output_nonfinite",
      "reasoning_nonfinite",
      "cache_read_nonfinite",
      "cache_write_nonfinite",
      "uncached_input_invalid",
      "output_invalid",
      "reasoning_invalid",
      "cache_read_invalid",
      "cache_write_invalid",
      "context_token_count_overflow",
      "input_price_unavailable",
      "output_price_unavailable",
      "cache_read_price_unavailable",
      "cache_write_price_unavailable",
      "input_price_invalid",
      "output_price_invalid",
      "cache_read_price_invalid",
      "cache_write_price_invalid",
      "reasoning_price_invalid",
      "estimated_cost_nonfinite"
    ],
    "reason_precedence": [
      "unsupported_runtime_accounting",
      "incomplete_pairs",
      "identity_unstable",
      "protocol_noncompliant",
      "estimated_cost_nonfinite",
      "estimated_cost_unavailable",
      "pricing_provenance_unavailable",
      "zero_correct_answers",
      "quality_evidence_unavailable",
      "fact_score_regressed",
      "full_pass_rate_regressed",
      "estimated_cost_per_correct_raw_tie",
      "estimated_cost_per_correct_rounded_tie",
      "estimated_cost_per_correct_not_lower"
    ]
  },
  "compatibility": {
    "schemas_1_through_4_byte_identical": true,
    "cache_reuse_v1_byte_identical": true,
    "historical_statements_unchanged": true
  }
}
