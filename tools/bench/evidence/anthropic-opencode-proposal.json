      "model": "claude-sonnet-5",
      "access_mode": "runtime",
      "credential_source": "opencode:Anthropic",
      "credential_type": "api",
      "runtime_binary": "opencode",
      "required_native_requests": 2,
      "required_attempts": 2,
      "max_input_tokens": 2048,
      "max_output_tokens": 32,
      "input_usd_per_million": 2,
      "cache_write_multiplier": 2,
      "output_usd_per_million": 10
