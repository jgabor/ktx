{
  "schema_version": 1,
  "paths": [
    {
      "name": "priced_openai",
      "source": "OpenAI public Responses API and OpenCode ChatGPT OAuth adapter",
      "version": "OpenAI REST 2020-10-01 / OpenCode 1.18.4 (49c69c5)",
      "references": [
        "https://developers.openai.com/api/reference/overview/",
        "https://github.com/anomalyco/opencode/blob/v1.18.4/packages/opencode/src/plugin/openai/codex.ts",
        "https://help.openai.com/en/articles/6950777-what-is-chatgpt-plus"
      ],
      "transport": "direct_openai",
      "provider": "openai",
      "model": "gpt-5.6-luna",
      "variant": "high",
      "access_mode": "source_only_unavailable",
      "credential_source": "opencode:OpenAI",
      "credential_type": "oauth",
      "unavailable_condition": "OpenCode 1.18.4 ChatGPT OAuth is consumed by its adapter, which adds ChatGPT account metadata and rewrites requests to the ChatGPT Codex endpoint; the OpenAI public Responses API documents API keys or workload-identity access tokens, not reuse of this ChatGPT OAuth credential, so no documented supported direct public Responses API path is available",
      "required_native_requests": 2,
      "required_attempts": 2,
      "max_input_tokens": 8192,
      "max_output_tokens": 64,
      "input_usd_per_million": 1.0,
      "cache_write_multiplier": 1.25,
      "output_usd_per_million": 6.0
    },
    {
      "name": "routine_opencode",
      "source": "OpenCode step-finish event and request runtime",
      "version": "1.18.4",
      "references": [
        "https://github.com/anomalyco/opencode/tree/49c69c5ed3ccf706b61b3febb43c8aaff7f8325e"
      ],
      "transport": "opencode",
      "provider": "opencode",
      "model": "big-pickle",
      "access_mode": "runtime",
      "credential_source": "environment:OPENCODE_API_KEY",
      "credential_type": "api",
      "runtime_binary": "opencode",
      "required_native_requests": 2,
      "required_attempts": 2,
      "max_input_tokens": 8192,
      "max_output_tokens": 64,
      "input_usd_per_million": 0,
      "cache_write_multiplier": 1,
      "output_usd_per_million": 0
    }
  ],
  "limits": {
    "max_native_requests": 4,
    "max_attempts": 4,
    "max_spend_usd": 0.025,
    "max_wall_time": "2m"
  },
  "artifact_destination": ".bench-data/cache-evidence/openai-opencode-luna-high-20260724",
  "redaction_policy": [
    "omit credentials and authorization headers",
    "retain only SHA-256 of prompt cache keys",
    "omit or SHA-256 sensitive correlation identifiers",
    "retain synthetic prompts only",
    "keep provider-native and OpenCode source records separate"
  ]
}
