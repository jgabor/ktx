{
  "schema": "ktx.targeted-residual-evidence-matrix.v2",
  "opportunity_signal": {
    "tool": "read",
    "command": null,
    "subcommand": null,
    "profile": "default",
    "route": "default_fallback",
    "disposition": "anti_worsening_rejected",
    "output_size_band": "1k-10k"
  },
  "routing_contract": {
    "candidate_predicates": ["tool=read", "exit_status=success"],
    "unsupported_predicates": ["content", "output_size"],
    "precedence": "ordered_first_match",
    "eligible_when": "tool is read and outcome is explicit success",
    "otherwise": "byte_exact_passthrough"
  },
  "evaluation_rules": [
    "Evaluate every case; omission is failure.",
    "An eligible result must preserve every required fact at its exact occurrence count.",
    "Error text and error state must be preserved exactly.",
    "Recovery must reproduce the original input byte for byte.",
    "An ineligible case must pass through byte for byte and must not create a transformed artifact.",
    "Eligibility may use only configured tool, command prefix, subcommand, and documented exit status; ordered first match wins.",
    "A candidate fails if any case grows, loses required evidence, changes an occurrence count, changes error behavior, or violates passthrough."
  ],
  "cases": [
    {
      "id": "eligible-head",
      "categories": ["head", "eligible"],
      "tool": "read",
      "outcome": "success",
      "generator": {
        "algorithm": "fixed_lines_v1", "bytes": 4096, "fill_byte": ".", "newline_every": 64,
        "placements": [
          { "fact": "HEAD_REQUIRED", "offsets": [0] },
          { "fact": "REPEATED_FACT", "offsets": [512, 1024, 1536] }
        ]
      },
      "expected": {
        "required_facts": [
          { "fact": "HEAD_REQUIRED", "exact_occurrences": 1 },
          { "fact": "REPEATED_FACT", "exact_occurrences": 3 }
        ],
        "errors": { "is_error": false, "required_text": null, "exact_occurrences": 0 },
        "recovery": "byte_exact_original", "eligible": true, "passthrough": false
      }
    },
    {
      "id": "eligible-middle",
      "categories": ["middle", "eligible"],
      "tool": "read",
      "outcome": "success",
      "generator": {
        "algorithm": "fixed_lines_v1", "bytes": 5120, "fill_byte": ".", "newline_every": 64,
        "placements": [
          { "fact": "MIDDLE_REQUIRED", "offsets": [2560] },
          { "fact": "REPEATED_FACT", "offsets": [512, 1536, 3584, 4608] }
        ]
      },
      "expected": {
        "required_facts": [
          { "fact": "MIDDLE_REQUIRED", "exact_occurrences": 1 },
          { "fact": "REPEATED_FACT", "exact_occurrences": 4 }
        ],
        "errors": { "is_error": false, "required_text": null, "exact_occurrences": 0 },
        "recovery": "byte_exact_original", "eligible": true, "passthrough": false
      }
    },
    {
      "id": "eligible-tail",
      "categories": ["tail", "eligible"],
      "tool": "read",
      "outcome": "success",
      "generator": {
        "algorithm": "fixed_lines_v1", "bytes": 6144, "fill_byte": ".", "newline_every": 64,
        "placements": [
          { "fact": "TAIL_REQUIRED", "offsets": [6128] },
          { "fact": "REPEATED_FACT", "offsets": [512, 1536, 2560, 3584, 4608] }
        ]
      },
      "expected": {
        "required_facts": [
          { "fact": "TAIL_REQUIRED", "exact_occurrences": 1 },
          { "fact": "REPEATED_FACT", "exact_occurrences": 5 }
        ],
        "errors": { "is_error": false, "required_text": null, "exact_occurrences": 0 },
        "recovery": "byte_exact_original", "eligible": true, "passthrough": false
      }
    },
    {
      "id": "eligible-structured",
      "categories": ["structured", "eligible"],
      "tool": "read",
      "outcome": "success",
      "generator": {
        "algorithm": "json_object_v1", "bytes": 7168,
        "json": { "required_fact": "STRUCTURED_REQUIRED", "repeated_fact": "REPEATED_FACT", "repeated_count": 3, "padding_byte": "x" }
      },
      "expected": {
        "required_facts": [
          { "fact": "STRUCTURED_REQUIRED", "exact_occurrences": 1 },
          { "fact": "REPEATED_FACT", "exact_occurrences": 3 }
        ],
        "errors": { "is_error": false, "required_text": null, "exact_occurrences": 0 },
        "recovery": "byte_exact_original", "eligible": true, "passthrough": false
      }
    },
    {
      "id": "reject-failure",
      "categories": ["failure", "passthrough"],
      "tool": "read",
      "outcome": "failure",
      "generator": {
        "algorithm": "fixed_lines_v1", "bytes": 4096, "fill_byte": ".", "newline_every": 64,
        "placements": [
          { "fact": "ERROR: permission denied", "offsets": [1024, 2048] },
          { "fact": "PATH_REQUIRED", "offsets": [4000] }
        ]
      },
      "expected": {
        "required_facts": [{ "fact": "PATH_REQUIRED", "exact_occurrences": 1 }],
        "errors": { "is_error": true, "required_text": "ERROR: permission denied", "exact_occurrences": 2 },
        "recovery": "byte_exact_original", "eligible": false, "passthrough": true
      }
    },
    {
      "id": "reject-tool",
      "categories": ["passthrough"],
      "tool": "bash",
      "outcome": "success",
      "generator": {
        "algorithm": "fixed_lines_v1", "bytes": 4096, "fill_byte": ".", "newline_every": 64,
        "placements": [{ "fact": "OTHER_TOOL_REQUIRED", "offsets": [2048] }]
      },
      "expected": {
        "required_facts": [{ "fact": "OTHER_TOOL_REQUIRED", "exact_occurrences": 1 }],
        "errors": { "is_error": false, "required_text": null, "exact_occurrences": 0 },
        "recovery": "byte_exact_original", "eligible": false, "passthrough": true
      }
    },
    {
      "id": "reject-unknown-outcome",
      "categories": ["passthrough"],
      "tool": "read",
      "outcome": "unknown",
      "generator": {
        "algorithm": "fixed_lines_v1", "bytes": 4096, "fill_byte": ".", "newline_every": 64,
        "placements": [{ "fact": "UNKNOWN_OUTCOME_REQUIRED", "offsets": [2048] }]
      },
      "expected": {
        "required_facts": [{ "fact": "UNKNOWN_OUTCOME_REQUIRED", "exact_occurrences": 1 }],
        "errors": { "is_error": null, "required_text": null, "exact_occurrences": 0 },
        "recovery": "byte_exact_original", "eligible": false, "passthrough": true
      }
    }
  ]
}
