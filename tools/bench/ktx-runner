#!/bin/sh
set -eu

# ktx-runner: container entrypoint for ktx compression benchmark runs.
#
# usage:
#   ktx-runner [-m model] [--format json] "<prompt>"
#   ktx-runner --identity
#   ktx-runner --version
#
# The runner wraps `opencode run` with JSON output parsing. The ktx
# plugin is pre-installed in the image; the ktx.toml config is
# bind-mounted at /home/node/.config/ktx/ktx.toml.
#
# Environment:
#   KTX_DB   - ktx database path (default: /home/node/.local/share/ktx/ktx.db)
#   MODEL    - default model if -m not passed

identity() {
  for name in ktx opencode; do
    if command -v "$name" >/dev/null 2>&1; then
      version="$("$name" --version 2>/dev/null || echo "available")"
      printf '%s\t%s\n' "$name" "$version"
    else
      printf '%s\tmissing\n' "$name"
    fi
  done
}

if [ "${1:-}" = "--identity" ]; then
  identity
  exit 0
fi

if [ "${1:-}" = "--version" ]; then
  ktx --version
  opencode --version
  exit 0
fi

# Parse args: extract -m/--model, pass the rest to opencode as the prompt.
model="${MODEL:-}"
format="json"
prompt=""

while [ $# -gt 0 ]; do
  case "$1" in
    -m|--model)
      model="$2"
      shift 2
      ;;
    --format)
      format="$2"
      shift 2
      ;;
    --pure)
      shift
      ;;
    *)
      prompt="$1"
      shift
      ;;
  esac
done

if [ -z "$prompt" ]; then
  printf 'usage: ktx-runner [-m model] "<prompt>"\n' >&2
  exit 1
fi

if [ -z "$model" ]; then
  printf 'ktx-runner: model required (-m <model> or MODEL env)\n' >&2
  exit 1
fi

# Verify auth is mounted.
auth="${OPENCODE_AUTH_PATH:-/home/node/.local/share/opencode/auth.json}"
if [ ! -f "$auth" ]; then
  printf 'ktx-runner: opencode auth missing; mount auth.json at %s\n' "$auth" >&2
  exit 2
fi

# Verify ktx config is present (even if it's a passthrough stages=[]).
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-/home/node/.config}"
ktx_config="$XDG_CONFIG_HOME/ktx/ktx.toml"
if [ ! -f "$ktx_config" ]; then
  printf 'ktx-runner: ktx config missing; mount ktx.toml at %s\n' "$ktx_config" >&2
  exit 2
fi

export KTX_DB="${KTX_DB:-/home/node/.local/share/ktx/ktx.db}"

if [ -n "${KTX_EXPECTED_STAGES_JSON:-}" ]; then
  actual_stages="$(ktx config show --format json | jq -c '.profiles.default.stages')"
  if [ "$actual_stages" != "$KTX_EXPECTED_STAGES_JSON" ]; then
    printf 'ktx-runner: configured stages mismatch: expected=%s actual=%s\n' \
      "$KTX_EXPECTED_STAGES_JSON" "$actual_stages" >&2
    exit 2
  fi
fi

# Run opencode with the ktx plugin active. The plugin intercepts
# tool.execute.after and compresses output per the mounted ktx.toml.
# stdout carries the JSONL event stream (including step_finish with
# tokens/cost); stderr carries opencode diagnostics.
exec opencode run --format "$format" -m "$model" "$prompt"
