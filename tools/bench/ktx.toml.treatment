# ktx.toml for benchmark treatment (conservative compression pipeline)
#
# Mount this file at /home/node/.config/ktx/config.toml for the
# treatment arm. The ktx plugin compresses each tool_call output
# in-flight via the configured pipeline before the agent sees it.
#
# Tested on real hook-path data: 80-88% per-call reduction.

[pipeline.default]
stages = ["strip-ansi", "dedup-blank", "normalize", "keep-ends:50:20", "token-budget:2000"]
